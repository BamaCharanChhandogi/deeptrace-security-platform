{
  "info": {
    "name": "DeepTrace Cybernetics - Multi-Tenant Security Platform API",
    "description": "Complete Postman collection covering all endpoints: Auth, Multi-Tenant Isolation, Campaigns, Security Events, Audit Logs, and Dashboard Telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check (Keepalive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Tenant A Admin (Sarah Connor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('authToken', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cybershield.io\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Tenant B Admin (Cross-Tenant Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sentinelops.io\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Telemetry & Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Campaign Management",
      "item": [
        {
          "name": "List Campaigns (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns?page=1&limit=10&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Get Campaign By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", ":id"],
              "variable": [
                { "key": "id", "value": "11111111-1111-1111-1111-111111111111" }
              ]
            }
          }
        },
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q4 Executive Spear-Phishing Drill\",\n  \"description\": \"Simulated spear phishing campaign targeting executive teams.\",\n  \"status\": \"DRAFT\",\n  \"start_date\": \"2026-10-15\",\n  \"end_date\": \"2026-10-30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns"]
            }
          }
        },
        {
          "name": "Update Campaign (State Machine Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", ":id"],
              "variable": [
                { "key": "id", "value": "11111111-1111-1111-1111-111111111111" }
              ]
            }
          }
        },
        {
          "name": "Assign Member to Campaign",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_UUID_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/:id/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", ":id", "members"],
              "variable": [
                { "key": "id", "value": "11111111-1111-1111-1111-111111111111" }
              ]
            }
          }
        },
        {
          "name": "Delete Campaign (ADMIN Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/campaigns/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "campaigns", ":id"],
              "variable": [
                { "key": "id", "value": "11111111-1111-1111-1111-111111111111" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security Events",
      "item": [
        {
          "name": "List Security Events (Severity & Status Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/security-events?page=1&limit=10&severity=CRITICAL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "security-events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "severity", "value": "CRITICAL" }
              ]
            }
          }
        },
        {
          "name": "Record Security Incident",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"BRUTE_FORCE_ATTEMPT\",\n  \"severity\": \"HIGH\",\n  \"status\": \"OPEN\",\n  \"description\": \"Excessive failed password attempts detected from IP 198.51.100.44\",\n  \"source\": \"WAF Guard\",\n  \"metadata\": {\n    \"target_endpoint\": \"/api/auth/login\",\n    \"attempt_count\": 45\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/security-events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "security-events"]
            }
          }
        },
        {
          "name": "Update Incident Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"note\": \"IP permanently blocked on upstream Cloudflare WAF.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/security-events/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "security-events", ":id", "status"],
              "variable": [
                { "key": "id", "value": "EVENT_UUID_HERE" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Trail (ADMIN Only)",
      "item": [
        {
          "name": "Get Immutable Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs?page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "List Tenant Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Provision User (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Chen\",\n  \"email\": \"alex.chen@cybershield.io\",\n  \"password\": \"Security@123456\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    }
  ]
}
